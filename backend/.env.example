# ─────────────────────────────────────────────
# Copiar a `.env` y completar con valores reales.
# `.env` NUNCA se versiona: solo este archivo.
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=4001

# Usuario ADMIN inicial. El seed lo hashea con bcrypt: no se guarda el texto plano.
# El login es por email: `medicos_voluntarios.email` es UNIQUE.
ADMIN_EMAIL=cambiar-por-email-del-admin
ADMIN_NOMBRE=cambiar-por-nombre-del-admin
ADMIN_PASSWORD=cambiar-por-contrasena-fuerte

# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-cadena-aleatoria-de-minimo-32-caracteres
JWT_EXPIRES_IN=8h

# Lista blanca de orígenes, separada por comas y SIN espacios.
# Nunca comodín. Debe incluir el puerto del frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Usuario de aplicación con permisos SOLO sobre este esquema.
# Ver la sección "Base de datos MySQL" del README.md.
DATABASE_URL=mysql://app:cambiar-por-clave-fuerte@localhost:3306/meregalasunahora_dev

# Base de pruebas efímera que usa `prisma migrate dev`. Esquema aparte, sin datos:
# Prisma la borra y la recrea en cada `migrate dev`. Misma clave, otro nombre de base.
SHADOW_DATABASE_URL=mysql://app:cambiar-por-clave-fuerte@localhost:3306/meregalasunahora_shadow
