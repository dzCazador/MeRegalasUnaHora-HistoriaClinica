# ─────────────────────────────────────────────
# Copiar a `.env` y completar con valores reales.
# `.env` NUNCA se versiona: solo este archivo.
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Credenciales del usuario ADMIN inicial.
# El seed las hashea con bcrypt: no se guarda el texto plano.
# OJO: el spec (fase-02 tarea 2.2.6) usa ADMIN_EMAIL / ADMIN_NOMBRE / ADMIN_PASSWORD
# y login por email. Ver bloqueos B-8 en specs/fases/ESTADO.md.
AUTH_USERNAME=cambiar-por-usuario-admin
AUTH_PASSWORD=cambiar-por-contrasena-fuerte

# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-cadena-aleatoria-de-minimo-32-caracteres
JWT_EXPIRES_IN=8h

# Lista blanca de orígenes, separada por comas y SIN espacios.
# Nunca comodín. Debe incluir el puerto del frontend.
CORS_ORIGINS=http://localhost:3000

# Usuario de aplicación con permisos SOLO sobre este esquema.
# Ver la sección "Base de datos MySQL" del README.md.
DATABASE_URL=mysql://app:cambiar-por-clave-fuerte@localhost:3306/meregalasunahora_dev
